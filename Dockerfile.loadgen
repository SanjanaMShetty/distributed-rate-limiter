FROM golang:1.27-alpine AS build
WORKDIR /src
COPY tools/loadgen/go.mod tools/loadgen/go.sum ./
RUN go mod download
RUN mkdir -p /out
RUN go build -mod=readonly -trimpath -ldflags="-s -w" \
    -o /out/vegeta github.com/tsenart/vegeta/v12

FROM alpine:3.22
RUN adduser -D -u 10001 loadgen
COPY --from=build /out/vegeta /usr/local/bin/vegeta
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/vegeta"]
