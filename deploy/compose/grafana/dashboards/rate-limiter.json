{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (outcome) (rate(rate_limiter_decisions_total[1m]))", "legendFormat": "{{outcome}}", "refId": "A" }],
      "title": "Rate limit decisions per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(rate_limiter_decision_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "A" }],
      "title": "Redis-backed decision latency (p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum by (status) (rate(gateway_http_requests_total[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "title": "Gateway requests per second by result",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "increase(rate_limiter_store_errors_total[5m])", "legendFormat": "Redis errors", "refId": "A" }],
      "title": "Redis errors in the last five minutes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [{ "expr": "increase(rate_limiter_fail_open_total[5m])", "legendFormat": "Fail-open decisions", "refId": "A" }],
      "title": "Allowed without Redis in the last five minutes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [{ "expr": "rate_limiter_config_version_info", "legendFormat": "{{instance}} {{version}}", "refId": "A" }],
      "title": "Active limiter configuration version by gateway",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 7,
      "targets": [{ "expr": "sum by (policy, decision) (rate(rate_limiter_degraded_decisions_total[1m]))", "legendFormat": "{{policy}} / {{decision}}", "refId": "A" }],
      "title": "Degraded decisions by outage policy",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 8,
      "targets": [{ "expr": "rate_limiter_circuit_open_total", "legendFormat": "Circuit open", "refId": "A" }],
      "title": "Requests bypassing Redis due to open circuit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 9,
      "targets": [{ "expr": "rate_limiter_redis_inflight_rejected_total", "legendFormat": "In-flight cap", "refId": "A" }],
      "title": "Checks diverted by Redis in-flight cap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "id": 10,
      "targets": [{ "expr": "go_goroutines", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Gateway goroutines",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "id": 11,
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "{{instance}} RSS", "refId": "A" }],
      "title": "Gateway resident memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "id": 12,
      "targets": [{ "expr": "go_memstats_heap_alloc_bytes", "legendFormat": "{{instance}} heap", "refId": "A" }],
      "title": "Gateway allocated heap",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["rate-limiter", "redis"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
